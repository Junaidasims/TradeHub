# TradeHub Backend Server Configuration

PORT=5000
NODE_ENV=production
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.gofmo5z.mongodb.net/tradehub?retryWrites=true&w=majority

JWT_SECRET=your_super_secret_jwt_key_here
BCRYPT_SALT_ROUNDS=10

# Your deployed Render backend URL — used so uploaded image URLs resolve correctly
# e.g. https://tradehub-api.onrender.com
BACKEND_URL=https://your-render-service-name.onrender.com

# Your Vercel frontend URL — enables CORS for it
FRONTEND_URL=https://your-app.vercel.app

# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
